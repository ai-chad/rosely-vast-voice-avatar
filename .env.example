# These are startup environment settings for provision_vast.sh.
# Never commit real AWS or API keys.
AWS_DEFAULT_REGION=us-east-1
S3_PREFIX=s3://rosely-infrastructure/serverless/voice-avatar
# On Vast outside AWS, use AWS credentials with s3:GetObject restricted to this prefix.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Alternate download path: presigned object URLs instead of AWS credentials.
# MODEL_ARCHIVE_URL=https://...
# MODEL_SHA_URL=https://...
WORKSPACE=/workspace
MUSE_BATCH_SIZE=4
FETCH_BUILTIN_VOICES=1
# Generated on first provisioning and stored in /workspace/rosely-voice-avatar.env:
# VOICE_API_KEY=...
# GATEWAY_API_KEY=...
