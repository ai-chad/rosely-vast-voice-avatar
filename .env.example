# This is a TEMPLATE, not a file to commit with real keys.
PYWORKER_REPO=https://github.com/ai-chad/rosely-vast-voice-avatar
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/ai-chad/rosely-vast-voice-avatar/main/provision_serverless.sh
SERVERLESS=true
MODEL_S3_URI=s3://rosely-infrastructure/serverless/voice-avatar/rosely-voice-musetalk-v1.tar.zst
ROSELY_AVATAR_S3_REGION=us-east-1
ROSELY_AVATAR_S3_ACCESS_KEY_ID=YOUR_SCOPED_READ_ONLY_KEY
ROSELY_AVATAR_S3_SECRET_ACCESS_KEY=YOUR_SCOPED_READ_ONLY_SECRET
# ROSELY_AVATAR_S3_SESSION_TOKEN=OPTIONAL_FOR_TEMPORARY_CREDENTIALS
FETCH_BUILTIN_VOICES=1
MUSE_BATCH_SIZE=4
GATEWAY_PORT=8000
SERVERLESS_ADAPTER_PORT=8004
# MODEL_ARCHIVE_SHA256=the actual sha from EC2; optional, remote .sha256 is checked regardless
# MODEL_ARCHIVE_SIZE=actual byte count; optional
